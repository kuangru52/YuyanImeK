<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.NoDivider</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <style name="PreferenceThemeOverlay.NoDivider" parent="@style/PreferenceThemeOverlay">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <style name="Theme.CropActivityTheme" parent="Theme.AppCompat.DayNight">
        <item name="android:statusBarColor">?android:attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
