<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/privacy_policy_sure"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bkg_privacy_btn_agree"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onclick"
        android:text="@string/privacy_policy_sure"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/privacy_policy_cancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:background="@drawable/bkg_privacy_btn_reject"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onclick"
        android:text="@string/privacy_policy_cancel"
        android:textColor="@color/settings_summary_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
